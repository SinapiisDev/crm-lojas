# Copie para .env.local (desenvolvimento) ou configure no provedor (produção). Nunca commite valores reais.

# Supabase — local: valores do `npx supabase start`; produção: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Endereço público do CRM (links dos e-mails e volta do login Google)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push (VAPID) — gerar uma vez: node --input-type=module -e "import {generateVAPIDKeys} from 'web-push'; console.log(generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ASSUNTO=mailto:avisos@seu-dominio.com.br

# E-mail — local: Mailpit (127.0.0.1:54325, sem usuário); produção: Resend (smtp.resend.com, 465, usuário "resend", senha = API key)
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE="CRM Lojas <avisos@seu-dominio.com.br>"

# Segredo da rota /api/avisos/despachar — o mesmo valor vai no Vault do banco (avisos_segredo)
AVISOS_SEGREDO=
